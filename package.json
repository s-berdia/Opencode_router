{
  "name": "@s-berdia/opencode-router",
  "version": "1.4.1",
  "description": "Early-development automatic model routing and quota failover for OpenCode Go, Go Plus, Go Teams, and Free. Expect bugs; issues and contributions welcome.",
  "type": "module",
  "license": "MIT",
  "author": "s-berdia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-berdia/Opencode_router.git"
  },
  "homepage": "https://github.com/s-berdia/Opencode_router#readme",
  "bugs": {
    "url": "https://github.com/s-berdia/Opencode_router/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "model-routing",
    "failover",
    "rate-limit",
    "quota",
    "llm",
    "ai-coding",
    "ai-agents",
    "experimental",
    "alpha",
    "contributions-welcome"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-router": "dist/bin.js"
  },
  "files": [
    "dist",
    "model-scores.json",
    "README.md",
    "USAGE.md",
    "docs/model-selection.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "refresh": "node dist/bin.js refresh",
    "status": "node dist/bin.js status",
    "scores": "node dist/bin.js scores"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.0",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^22.10.2",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
